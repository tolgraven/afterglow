#!/usr/bin/env python3
"""Route this commit to its Mac test result when a trusted worker has claimed it."""

from datetime import datetime, timedelta, timezone
from http.client import HTTPException
import json
import os
import sys
import time
from urllib.error import URLError
from urllib.request import Request, urlopen

CONTEXT = "local-mac/native-gpu"
OWNER_ID = 9143357
CLAIM_WAIT = 90
HEARTBEAT_LIFETIME = timedelta(seconds=150)
MAX_WAIT = 45 * 60


def reported_result(repository, sha, token, context):
    request = Request(
        f"https://api.github.com/repos/{repository}/commits/{sha}/statuses?per_page=100",
        headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"},
    )
    with urlopen(request, timeout=10) as response:
        statuses = json.load(response)
    for status in statuses:
        if status["context"] != context or (status.get("creator") or {}).get("id") != OWNER_ID:
            continue
        state = status["state"]
        if state in ("success", "failure"):
            return state
        if state == "pending":
            updated = datetime.fromisoformat(status["updated_at"].replace("Z", "+00:00"))
            if datetime.now(timezone.utc) - updated <= HEARTBEAT_LIFETIME:
                return "pending"
        return "unavailable"
    return "unclaimed"


def select_runner(repository, sha, token, context, *, offer):
    started = time.monotonic()
    last_status = started
    while True:
        now = time.monotonic()
        elapsed = now - started
        try:
            result = reported_result(repository, sha, token, context)
            last_status = now
        except (URLError, TimeoutError, HTTPException, ValueError, KeyError, TypeError) as error:
            interval = CLAIM_WAIT if offer else HEARTBEAT_LIFETIME.total_seconds()
            if elapsed >= MAX_WAIT or now - last_status >= interval:
                print(f"Mac status unavailable ({type(error).__name__}). Skipping the native Mac suite.", file=sys.stderr)
                return "hosted"
            time.sleep(10)
            continue
        if result == "success":
            return "local"
        if result == "failure":
            return "local-failure"
        if offer and result == "pending":
            return "claimed"
        if result == "unavailable" or elapsed >= MAX_WAIT:
            return "hosted"
        if result == "unclaimed" and elapsed >= CLAIM_WAIT:
            return "hosted"
        time.sleep(10)


if __name__ == "__main__":
    context = f"{CONTEXT}/{os.environ['GITHUB_RUN_ID']}.{os.environ['GITHUB_RUN_ATTEMPT']}"
    runner = select_runner(os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_SHA"],
                           os.environ["GH_TOKEN"], context, offer=sys.argv[1] == "offer")
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as output:
        print(f"runner={runner}", file=output)

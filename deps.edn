;; Hardware-free test entry point. project.clj remains the application manifest.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}}
 :aliases {:test {:extra-paths ["test" "dev"]
                  :jvm-opts ["-Djava.awt.headless=true"]
                  :main-opts ["-m" "afterglow.test-runner"]}}}
